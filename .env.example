# NestWorth configuration. Copy to .env and fill in what you need.
# Never commit .env: it holds your API key.

# --- AI provider -------------------------------------------------------------
# anthropic (Claude), openai (OpenAI or any OpenAI-compatible server such as
# Ollama or LM Studio), or mock (demo mode: keyword rules, no AI, no key needed).
LLM_PROVIDER=anthropic

# Anthropic (https://platform.claude.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_VERSION=2026-10-21
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# For Ollama: OPENAI_BASE_URL=http://localhost:11434/v1 and OPENAI_MODEL=<a model you've pulled>
# OPENAI_MAX_TOKENS_PARAM=max_completion_tokens   # some servers want max_tokens

# Optional web research about each home's area (Anthropic only; uses web search credits).
WEB_RESEARCH=false
# WEB_SEARCH_MAX_USES=5
# ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305

# LLM_MAX_TOKENS=16000
# LLM_TIMEOUT_MS=180000
# LLM_MAX_RETRIES=3

# --- Server ------------------------------------------------------------------
# 127.0.0.1 keeps the app on this computer only. Anything else makes it
# reachable from other machines, and then APP_ACCESS_TOKEN is required.
HOST=127.0.0.1
PORT=8787
# APP_ACCESS_TOKEN=          # at least 16 characters; people enter it in the app
# ALLOW_UNAUTHENTICATED=false
# TRUST_PROXY=false          # true only behind a reverse proxy you control

# --- Spending limits ----------------------------------------------------------
RATE_LIMIT_PER_10_MIN=20
DAILY_ASSESSMENT_LIMIT=200
MAX_CONCURRENT_ASSESSMENTS=3

# Optional: prices per million tokens, to log an estimated cost per assessment.
# Check your provider's current pricing.
# PRICE_INPUT_PER_MTOK=2
# PRICE_OUTPUT_PER_MTOK=10

# --- Reading listing links ------------------------------------------------------
# The app respects robots.txt and only reads public web pages. Many property
# portals don't allow automated reading; pasting the listing text always works.
ALLOW_LISTING_FETCH=true
# FETCH_USER_AGENT=NestWorthBot/0.1 (+https://github.com/vinovee/NestWorth; self-hosted home search; respects robots.txt)

LOG_LEVEL=info
